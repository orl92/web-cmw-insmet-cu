#!/usr/bin/env sh
# Versioned pre-commit hook.
#
# Activate with:   git config core.hooksPath .githooks
# (or simply:      make setup)
#
# NOTE: `pre-commit install` is MUTUALLY EXCLUSIVE with core.hooksPath.
# Setting core.hooksPath makes git ignore .git/hooks entirely, so running
# both leaves you debugging a hook that git never calls.
set -e
root=$(git rev-parse --show-toplevel)
if [ -x "$root/.venv/bin/pre-commit" ]; then
  exec "$root/.venv/bin/pre-commit" run --show-diff-on-failure --color=always "$@"
fi
exec pre-commit run --show-diff-on-failure --color=always "$@"
