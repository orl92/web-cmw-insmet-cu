#!/usr/bin/env sh
# Versioned pre-commit hook.
#
# Activate with:   git config core.hooksPath .githooks
# (or simply:      make setup)
#
# NOTE: `pre-commit install` is MUTUALLY EXCLUSIVE with core.hooksPath.
# Setting core.hooksPath makes git ignore .git/hooks entirely, so running
# both leaves you debugging a hook that git never calls.
set -e
root=$(git rev-parse --show-toplevel)
if [ -x "$root/.venv/bin/pre-commit" ]; then
  "$root/.venv/bin/pre-commit" run --show-diff-on-failure --color=always "$@"
else
  pre-commit run --show-diff-on-failure --color=always "$@"
fi

# ======== GGA START ========
# Gentleman Guardian Angel - Code Review
# NOTE: never `exec` above this line. `exec` replaces the shell process, so any
# step after it is dead code and gga would never run.
# Optional dependency: a machine or CI job without gga must still be able to
# commit, so skip silently instead of failing with "command not found".
if command -v gga >/dev/null 2>&1; then
  gga run || exit 1
fi
# ======== GGA END ========
