# Configuracion de deploy/deploy.sh.
#
# Instalar una vez en el servidor:
#   sudo install -o root -g root -m 0600 deploy/deploy.env.example /etc/webcmp/deploy.env
#   sudo nano /etc/webcmp/deploy.env
#
# El script lo carga con `source`, asi que es shell: solo `clave=valor` y nada
# de `export` (source ya los exporta al proceso hijo).
#
# Estos valores son los defaults del repo. Lo que cambia por instalacion son las
# rutas; si el checkout no esta en /srv/webcmp, cambiá APP_DIR aca Y las rutas de
# deploy/systemd/*.service, que las tiene escritas a proposito (systemd no expande
# variables en WorkingDirectory=).

# Checkout de git, dueno de DEPLOY_USER.
APP_DIR=/srv/webcmp

# Usuario del servicio. Dueño del venv, de media/ y de staticfiles/. Los
# comandos de manage.py corren como este usuario, nunca como root: si corrieran
# como root, los archivos quedarian con dueno root y el servicio dejaria de poder
# escribir en ellos.
DEPLOY_USER=webcmp

# Unidades systemd. Deben coincidir con los nombres de deploy/systemd/.
GUNICORN_UNIT=webcmp
HUEY_UNIT=webcmp-huey

# Clave de descifrado de SECRET_KEY. 600, propiedad de root.
ENCRYPTION_ENV=/etc/webcmp/encryption.env

# Interprete y pip del venv. No cambiar salvo que se mueva el venv.
PYTHON=/srv/webcmp/.venv/bin/python
PIP=/srv/webcmp/.venv/bin/pip

# Host del health check. Debe coincidir con `server_name` de Nginx y con
# EXTERNAL_HOSTNAME del .env: el health check entra por 127.0.0.1:443 con el SNI
# de este nombre, asi que si el nombre no coincide, TLS no encaja y el deploy
# falla aunque el sitio este perfecto.
PUBLIC_HOSTNAME=web.cmw.insmet.cu

# Cache de pip, propiedad de DEPLOY_USER.
#
# Sin esto pip no tiene cache: `webcmp` es una cuenta de sistema sin home y no
# encuentra donde escribir ~/.cache. Cada deploy vuelve a descargar todo desde
# PyPI, que multiplica el tiempo del deploy y hace que un corte de red se convierta
# en un deploy fallido. Las dependencias van todas pinadas con `==`, asi que un
# cache no puede servir un artefacto equivocado.
PIP_CACHE_DIR=/var/cache/webcmp-pip

