# ======================================
# CONFIGURACIÓN BÁSICA DE DJANGO
# ======================================

# True para desarrollo, False para producción
DEBUG=True

# Clave secreta (¡cambiar en producción!)
SECRET_KEY=<STRONG_KEY_HERE>

# Hosts permitidos (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes confiables para CSRF (separados por comas)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Hostname externo para INSMET
EXTERNAL_HOSTNAME=web.cmw.insmet.cu


# ======================================
# CONFIGURACIÓN DE BASE DE DATOS (elige una opción)
# ======================================

# ----------------------------
# Opción 1: MySQL
# ----------------------------
# DB_ENGINE=mysql
# DB_HOST=localhost
# DB_NAME=db
# DB_USERNAME=db_usr
# DB_PASS=pass
# DB_PORT=3306

# ----------------------------
# Opción 2: PostgreSQL
# ----------------------------
# DB_ENGINE=postgresql
# DB_HOST=localhost
# DB_NAME=db
# DB_USERNAME=db_usr
# DB_PASS=pass
# DB_PORT=5432

# Nota: Descomenta solo la opción que necesites


# ======================================
# CONFIGURACIÓN DE CORREO (elige una opción)
# ======================================

# ----------------------------
# Opción 1: Consola (desarrollo)
# ----------------------------
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ----------------------------
# Opción 2: Backend personalizado
# ----------------------------
# CUSTOM_EMAIL_BACKEND=core.custom_email_backend.CustomSTARTTLSBackend
# EMAIL_USE_SSL=False  # Requerido para el backend personalizado

# ----------------------------
# Opción 3: SMTP estándar (producción)
# ----------------------------
# Configuración común para SMTP:
# EMAIL_HOST=tu.servidor.smtp.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu_correo@dominio.com
# EMAIL_HOST_PASSWORD=tu_contraseña
# DEFAULT_FROM_EMAIL=Nombre <tu_correo@dominio.com>
# EMAIL_USE_TLS=True


# ======================================
# NOTAS GENERALES
# ======================================
# - Variables sin '#' están activas.
# - Para producción: DEBUG=False y usa HTTPS.
# - Las contraseñas deben ser seguras y no compartirse.
