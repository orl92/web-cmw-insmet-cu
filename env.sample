
# ======================================
# CONFIGURACIÓN ESENCIAL
# ======================================

# Entorno: True=desarrollo, False=producción
DEBUG=True

# Clave secreta (¡NO compartir en producción!)
SECRET_KEY=tu_clave_secreta_aqui

# Hosts permitidos (separar por comas)
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes seguros (usar HTTPS en producción)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Orígenes CORS permitidos para API (separar por comas)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Dominio principal
EXTERNAL_HOSTNAME=web.cmw.insmet.cu


# ======================================
# BASE DE DATOS (PostgreSQL recomendado)
# ======================================

DB_ENGINE=postgresql
DB_NAME=meteorologia
DB_USERNAME=usuario_db
DB_PASS=contraseña_segura
DB_HOST=db.insmet.cu
DB_PORT=5432


# ======================================
# CONFIGURACIÓN DE CORREO
# ======================================
EMAIL_USE_TLS = True           # True para TLS
EMAIL_USE_SSL = False          # False si usas TLS
EMAIL_HOST=mail.insmet.cu
EMAIL_PORT=587
EMAIL_HOST_USER=notificaciones@cmw.insmet.cu
EMAIL_HOST_PASSWORD=contraseña_correo
DEFAULT_FROM_EMAIL="Centro Meteorológico Camagüey<notificaciones@cmw.insmet.cu>"


# ======================================
# OPCIONES AVANZADAS
# ======================================

# Para usar backend de consola (solo desarrollo)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Para usar backend personalizado
# CUSTOM_EMAIL_BACKEND=core.custom_email_backend.CustomSTARTTLSBackend
# EMAIL_USE_SSL = False


# ======================================
# SEGURIDAD
# ======================================
# ¡ADVERTENCIA! Este archivo no debe compartirse
# en entornos públicos. Configure permisos:
# chmod 600 .env
